---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Set false for pages that should not be indexed (e.g. 404). */
  index?: boolean;
}

const { title, description = site.description, type = 'website', index = true } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f8f8fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14121d" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Resolve the theme before first paint: saved choice, else the system setting.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage blocked: fall back to the system setting.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="bg-ink text-bg sr-only z-50 rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

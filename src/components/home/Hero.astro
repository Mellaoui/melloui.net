---
import { ArrowRight } from '@lucide/astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import HeroCanvas from '@/components/three/HeroCanvas.astro';
import { site } from '@/lib/site';
---

<section aria-labelledby="hero-title" class="container-page grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
  <div>
    <p class="eyebrow">
      {site.name} · {site.title}
    </p>
    <h1 id="hero-title" class="text-ink mt-5 text-[clamp(2.25rem,1.5rem+2.6vw,3.75rem)] leading-[1.06] font-extrabold">
      I turn complex problems into <span class="text-accent">simple, reliable software.</span>
    </h1>
    <p class="text-lead text-ink-muted mt-6 max-w-xl">
      I'm a software engineer who combines deep technical experience with AI-powered workflows to architect systems, build products, and
      deliver meaningful results.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink href="/work/">
        Selected work <ArrowRight class="size-4" aria-hidden="true" />
      </ButtonLink>
      <ButtonLink href="#contact" variant="secondary">
        Let's work together
      </ButtonLink>
    </div>
  </div>
  <HeroCanvas />
</section>

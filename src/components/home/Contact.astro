---
import { ArrowRight, Mail } from '@lucide/astro';
import { site, socials } from '@/lib/site';
---

<section id="contact" aria-labelledby="contact-title" class="bg-night text-night-ink scroll-mt-20">
  <div class="container-page py-20 md:py-28">
    <div class="border-night-surface relative overflow-hidden rounded-[2rem] border cta-glow px-6 py-16 text-center sm:px-12 md:py-20">
      <p class="code-tag text-accent-soft">&lt;contact via="email" /&gt;</p>
      <h2 id="contact-title" class="text-h2 mx-auto mt-6 max-w-2xl font-bold">
        Have a system that needs to be reliable? Let's talk.
      </h2>
      <p class="text-night-muted text-lead mx-auto mt-4 max-w-xl">
        Backend architecture, integrations, or an AI feature that has to work in production. Send a short note about the problem.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={`mailto:${site.email}`} class="btn-accent inline-flex items-center gap-3 rounded-full px-6 py-3 font-semibold">
          <Mail class="size-5" aria-hidden="true" />
          {site.email}
        </a>
        <a
          href="/work/"
          class="bg-night-surface hover:text-accent-soft inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold transition-colors"
        >
          Selected work
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap justify-center gap-2" aria-label="Elsewhere">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank" class="code-tag text-night-muted hover:text-night-ink transition-colors">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

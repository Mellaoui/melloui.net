---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contact from '@/components/home/Contact.astro';
import { about, experience, site } from '@/lib/site';
---

<BaseLayout title="About" description={`About ${site.name}, ${site.title.toLowerCase()} based in ${site.location}.`}>
  <section class="container-page py-16 md:py-24">
    <p class="eyebrow">About</p>
    <h1 class="text-display text-ink mt-4 max-w-4xl font-extrabold">{site.statement}</h1>
    <div class="mt-14 grid gap-14 lg:grid-cols-[1.4fr_1fr]">
      <div class="text-lead text-ink-muted space-y-5">
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <ul class="flex flex-wrap gap-2 pt-2" aria-label="Focus areas">
          {about.focus.map((f) => (
            <li class="border-line text-ink rounded-full border bg-surface px-3 py-1 text-sm">{f}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="font-heading text-ink text-lg font-bold">Experience</h2>
        <ol class="divide-line border-line mt-4 divide-y border-y">
          {experience.map((e) => (
            <li class="py-4">
              <p class="text-ink font-semibold">{e.role}</p>
              <p class="text-ink-muted text-sm">
                {e.company} · <span class="font-mono">{e.period}</span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
  <Contact />
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getProjects, type Project } from '@/lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, category, technologies, role, date, coverImage, status, url } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description} type="article">
  <article class="container-page py-16 md:py-24">
    <a href="/work/" class="text-ink-muted hover:text-accent text-sm">
      ← All work
    </a>
    <p class="eyebrow mt-8">{category}</p>
    <h1 class="text-display text-ink mt-4 max-w-4xl font-extrabold">{title}</h1>
    <p class="text-lead text-ink-muted mt-5 max-w-2xl">{description}</p>
    {url && (
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={url}
          rel="noopener"
          target="_blank"
          class="btn-accent inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold"
        >
          Visit {new URL(url).host}
          <ArrowUpRight class="size-4" aria-hidden="true" />
        </a>
        {status === 'live' && (
          <span class="code-tag text-emerald-700 dark:text-emerald-400">
            <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />
            live in production
          </span>
        )}
      </div>
    )}
    <dl class="border-line mt-10 grid gap-6 border-y py-6 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-ink-muted">Role</dt>
        <dd class="text-ink mt-1 font-semibold">{role}</dd>
      </div>
      <div>
        <dt class="text-ink-muted">{status === 'live' ? 'Updated' : 'Date'}</dt>
        <dd class="text-ink mt-1 font-semibold">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </dd>
      </div>
      {technologies.length > 0 && (
        <div>
          <dt class="text-ink-muted">Technologies</dt>
          <dd class="text-ink mt-1 font-semibold">{technologies.join(', ')}</dd>
        </div>
      )}
    </dl>
    {coverImage && (
      <Image
        src={coverImage}
        alt=""
        class="mt-10 w-full rounded-(--radius-card)"
        widths={[640, 960, 1200]}
        sizes="(min-width: 1200px) 1200px, 100vw"
      />
    )}
    <div class="prose-content text-ink mt-12">
      <Content />
    </div>
  </article>
</BaseLayout>
